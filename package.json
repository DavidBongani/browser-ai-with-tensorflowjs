{
  "name": "browser-ai-with-tensorflowjs",
  "version": "0.1.0",
  "private": false,
  "description": "Open-source companion repository for Browser AI with TensorFlow.js.",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
