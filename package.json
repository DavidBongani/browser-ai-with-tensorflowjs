    "check": "npm run test"
  },
  "dependencies": {
    "@tensorflow/tfjs": "4.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
